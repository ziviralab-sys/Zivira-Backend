API_PORT=4000
CORS_ORIGINS=https://zivira-labs-super-admin.vercel.app,https://zivira-labs-admin.vercel.app,https://zivira-labs-field-repo.vercel.app,https://zivira-labs-manager.vercel.app
MONGODB_URI=mongodb+srv://user:password@cluster.example/zivira-labs
JWT_SECRET=replace-with-a-long-random-secret
AUTO_APPROVE_HOURS=24
# Protects POST /api/seed/run and POST /api/seed/exact-10 — required on Render
# since the free tier has no shell access to run seed scripts directly.
# Set a long random value; remove/rotate it once you no longer need remote seeding.
SEED_SECRET=replace-with-a-long-random-secret
